{
  "schema_version": "aoa_scripts_registry_v2",
  "authority_ref": "scripts/README.md",
  "agents_ref": "scripts/AGENTS.md",
  "root_policy": {
    "root_python_glob": "scripts/*.py",
    "family_python_glob": "scripts/*/*.py",
    "root_role": "root scripts directory is a family-scoped center tooling district; Python entrypoints and helpers live under family directories",
    "root_python_policy": "no root-level Python files except package markers",
    "ignored_local_artifact_globs": [
      "scripts/__pycache__/**",
      "scripts/*/__pycache__/**"
    ]
  },
  "script_families": [
    {
      "family_id": "release-gate",
      "role": "public release check orchestration",
      "source_ref": "mechanics/release-support/README.md",
      "paths": [
        "scripts/release_gate/release_check.py"
      ],
      "must_not_claim": [
        "release success without the commands it orchestrates passing"
      ],
      "family_dir": "release_gate"
    },
    {
      "family_id": "center-entry",
      "role": "center entry map building, route parity, and validation",
      "source_ref": "docs/START_HERE_ROUTE_CONTRACT.md",
      "paths": [
        "scripts/center_entry/build_center_entry_map.py",
        "scripts/center_entry/center_entry_map_common.py",
        "scripts/center_entry/validate_center_entry_map.py",
        "scripts/center_entry/validate_entry_surface_sync.py"
      ],
      "must_not_claim": [
        "public route authority beyond the source route contract"
      ],
      "family_dir": "center_entry"
    },
    {
      "family_id": "root-registries",
      "role": "root config, schema, manifest, technical district, and ecosystem registry validation",
      "source_ref": "docs/ROOT_SURFACE_LAW.md",
      "paths": [
        "scripts/root_registries/validate_config_registry.py",
        "scripts/root_registries/validate_ecosystem.py",
        "scripts/root_registries/validate_manifests_registry.py",
        "scripts/root_registries/validate_schema_registry.py",
        "scripts/root_registries/validate_scripts_district.py",
        "scripts/root_registries/validate_tests_district.py"
      ],
      "must_not_claim": [
        "registry metadata as source doctrine"
      ],
      "family_dir": "root_registries"
    },
    {
      "family_id": "docs-districts",
      "role": "root docs district cleanup, indexes, decisions, and trace receipts",
      "source_ref": "docs/README.md",
      "paths": [
        "scripts/docs_districts/build_docs_thematic_index.py",
        "scripts/docs_districts/decision_indexes.py",
        "scripts/docs_districts/docs_thematic_common.py",
        "scripts/docs_districts/generate_decision_indexes.py",
        "scripts/docs_districts/plan_docs_thematic_cleanup.py",
        "scripts/docs_districts/validate_decision_records.py",
        "scripts/docs_districts/validate_docs_migration_map.py",
        "scripts/docs_districts/validate_docs_thematic_districts.py",
        "scripts/docs_districts/validate_docs_thematic_index.py",
        "scripts/docs_districts/validate_traces_district.py"
      ],
      "must_not_claim": [
        "historical receipts as current law"
      ],
      "family_dir": "docs_districts"
    },
    {
      "family_id": "organ-contract",
      "role": "AbyssOS repo-organ contract validation",
      "source_ref": "docs/organ-contract/README.md",
      "paths": [
        "scripts/organ_contract/validate_organ_contract.py"
      ],
      "must_not_claim": [
        "organ contract validation as downstream implementation acceptance"
      ],
      "family_dir": "organ_contract"
    },
    {
      "family_id": "hygiene",
      "role": "link, Markdown, status vocabulary, generated freshness, and known-repair guardrails",
      "source_ref": "docs/guardrails/README.md",
      "paths": [
        "scripts/hygiene/build_link_shape_hygiene_index.py",
        "scripts/hygiene/hygiene_common.py",
        "scripts/hygiene/repair_known_link_drifts.py",
        "scripts/hygiene/validate_generated_freshness.py",
        "scripts/hygiene/validate_hygiene_suite.py",
        "scripts/hygiene/validate_link_shape_hygiene_index.py",
        "scripts/hygiene/validate_links.py",
        "scripts/hygiene/validate_markdown_shape.py",
        "scripts/hygiene/validate_status_vocabulary.py"
      ],
      "must_not_claim": [
        "style checks as semantic approval"
      ],
      "family_dir": "hygiene"
    },
    {
      "family_id": "agents-mesh",
      "role": "AGENTS-card shape, coverage, and compact mesh indexes",
      "source_ref": "docs/guardrails/AGENTS_MESH_PROTOCOL.md",
      "paths": [
        "scripts/agents_mesh/agents_mesh_common.py",
        "scripts/agents_mesh/build_agents_mesh_index.py",
        "scripts/agents_mesh/validate_agents_md_shape.py",
        "scripts/agents_mesh/validate_agents_mesh.py",
        "scripts/agents_mesh/validate_agents_mesh_index.py",
        "scripts/agents_mesh/validate_nested_agents.py"
      ],
      "must_not_claim": [
        "AGENTS coverage as proof that owner-local truth is complete"
      ],
      "family_dir": "agents_mesh"
    },
    {
      "family_id": "mechanics-topology",
      "role": "mechanics package topology, cards, artifact homes, and landing logs",
      "source_ref": "mechanics/README.md",
      "paths": [
        "scripts/mechanics_topology/build_mechanic_card_index.py",
        "scripts/mechanics_topology/validate_mechanic_artifact_topology.py",
        "scripts/mechanics_topology/validate_mechanic_card_index.py",
        "scripts/mechanics_topology/validate_mechanic_landing_logs.py",
        "scripts/mechanics_topology/validate_mechanic_readme_cards.py",
        "scripts/mechanics_topology/validate_mechanics_topology.py"
      ],
      "must_not_claim": [
        "mechanic validation as owner acceptance in sibling repos"
      ],
      "family_dir": "mechanics_topology"
    },
    {
      "family_id": "owner-requests",
      "role": "center-side owner request queue building and validation",
      "source_ref": "mechanics/README.md",
      "paths": [
        "scripts/owner_requests/build_owner_request_queue.py",
        "scripts/owner_requests/validate_generated_owner_request_queue.py",
        "scripts/owner_requests/validate_owner_request_docs.py",
        "scripts/owner_requests/validate_owner_request_queue.py"
      ],
      "must_not_claim": [
        "owner request readiness as downstream implementation"
      ],
      "family_dir": "owner_requests"
    }
  ],
  "script_home_globs": [
    {
      "home_ref": "script-home:mechanic-root",
      "owner_scope": "mechanic",
      "path_glob": "mechanics/*/scripts"
    },
    {
      "home_ref": "script-home:mechanic-part",
      "owner_scope": "mechanic-part",
      "path_glob": "mechanics/*/parts/*/scripts"
    },
    {
      "home_ref": "script-home:spark-lane",
      "owner_scope": "agent-lane",
      "path_glob": ".agents/spark/scripts"
    }
  ],
  "validation_commands": [
    "python scripts/root_registries/validate_scripts_district.py",
    "python -m pytest -q tests/test_scripts_district.py",
    "python scripts/release_gate/release_check.py"
  ]
}
